        },
        "paymentMode": {
          "type": "string",
          "enum": ["Cash", "UPI", "Bank Transfer"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "date",
        "category",
        "description",
        "amount",
        "paymentMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "Cash or digital payment received against an invoice.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "invoiceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "customerId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "amount": {
          "type": "number"
        },
        "method": {

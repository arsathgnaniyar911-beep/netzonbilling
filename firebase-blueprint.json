        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "invoiceId",
        "order",
        "description",
        "unit",
        "quantity",
        "unitPrice",
        "lineTotal",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvoiceNumberLock": {
      "title": "InvoiceNumberLock",
      "description": "Atomic uniqueness lock preventing duplicate invoice numbers per workspace.",
      "type": "object",

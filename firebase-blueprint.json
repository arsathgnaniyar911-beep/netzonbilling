        "jobTitle",
        "date",
        "customerId",
        "customerName",
        "invoiceId",
        "invoiceNumber",
        "estimatedSellingPrice",
        "materials",
        "totalMaterialCost",
        "labourCost",
        "transportCost",
        "installationCost",
        "otherJobCost",
        "totalJobCost",

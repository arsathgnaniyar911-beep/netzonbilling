          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "customerId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "invoiceId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40

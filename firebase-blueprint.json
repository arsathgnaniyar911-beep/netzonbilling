        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "invoiceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",

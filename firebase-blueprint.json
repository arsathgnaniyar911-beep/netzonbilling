        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "invoiceId",
        "invoiceNumber",
        "createdAt",
        "updatedAt"
      ]
    },

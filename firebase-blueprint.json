    "Expense": {
      "title": "Expense",
      "description": "General business operating expenses.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "category": {
          "type": "string",
          "enum": ["Rent", "Electricity", "Salary", "Transport", "Tools", "Miscellaneous"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "amount": {

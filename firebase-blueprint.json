        "customerName",
        "date",
        "amount",
        "method",
        "isAdvance",
        "reference",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/settings/{userId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Business settings document keyed by owner UID."
    },
    "/settings/{userId}/invoiceNumbers/{lockId}": {
      "schema": { "$ref": "#/entities/InvoiceNumberLock" },
      "description": "Unique invoice number locks scoped under the owner settings doc."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer directory documents scoped by ownerId."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Normal invoices scoped by ownerId."
    },
    "/invoices/{invoiceId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/InvoiceLineItem" },
      "description": "Unlimited line items subcollection belonging to an invoice."
    },
    "/jobCostings/{jobId}": {
      "schema": { "$ref": "#/entities/JobCosting" },
      "description": "Material cost calculator job records scoped by ownerId."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Operating expense records scoped by ownerId."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Customer payment receipts linked to invoices scoped by ownerId."
    }
  }
}

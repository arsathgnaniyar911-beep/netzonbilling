{
  "entities": {
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Configuration and profile details for the business workspace.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 25
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "invoicePrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5
        },
        "currencyCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 5
        },
        "nextInvoiceSeq": {
          "type": "number"
        },
        "logoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350000
        },
        "logoWhiteUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "address",
        "phone",
        "email",
        "invoicePrefix",
        "currencySymbol",
        "currencyCode",
        "nextInvoiceSeq",
        "createdAt",
        "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact and location details for Tamil Nadu mesh and interiors jobs.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "pincode": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "minLength": 6,
          "maxLength": 6
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "phone",
        "address",
        "pincode",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Normal invoice without GST breakdown tracking customer details, work site address, charges, totals, payments, and void status.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "customerId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 20
        },
        "customerAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "customerPincode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6
        },
        "workSiteAddress": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "itemCount": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "labourCharges": {
          "type": "number"
        },
        "transportCharges": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "advancePaid": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "balanceDue": {
          "type": "number"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "partial", "paid"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "voided"]
        },
        "voidReason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "invoiceNumber",
        "date",
        "customerId",
        "customerName",
        "customerPhone",
        "customerAddress",
        "customerPincode",
        "workSiteAddress",
        "itemCount",
        "subtotal",
        "discount",
        "labourCharges",
        "transportCharges",
        "total",
        "advancePaid",
        "paidAmount",
        "balanceDue",
        "paymentStatus",
        "status",
        "voidReason",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvoiceLineItem": {
      "title": "InvoiceLineItem",
